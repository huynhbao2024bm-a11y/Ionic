NODE_ENV=development
PORT=3000
WEB_ORIGINS=http://127.0.0.1:4200
ALLOW_SIGNUP=true
DATABASE_URL=postgresql://ionic_app:ionic_local_only@127.0.0.1:5432/ionic
RECOMMENDATION_TAXONOMY_VERSION=ionic-taxonomy-v1
RECOMMENDATION_RANKER_VERSION=ionic-deterministic-v1
RECOMMENDATION_CANDIDATE_LIMIT=500
RECOMMENDATION_FRESHNESS_HALF_LIFE_MS=86400000
RECOMMENDATION_PREFERENCE_HALF_LIFE_MS=1209600000
RECOMMENDATION_PREFERENCE_EXPIRY_MS=5184000000
RECOMMENDATION_MIN_PREFERENCE_CONFIDENCE=0.55
RECOMMENDATION_STRONG_MATCH_THRESHOLD=0.18
RECOMMENDATION_MAX_PER_CREATOR=3
RECOMMENDATION_MAX_PER_TOPIC=4
RECOMMENDATION_MAX_CONSECUTIVE_TOPIC=2
RECOMMENDATION_RECENT_EXPOSURE_WINDOW_MS=604800000
RECOMMENDATION_WEIGHT_TOPIC=1
RECOMMENDATION_WEIGHT_FORMAT=1
RECOMMENDATION_WEIGHT_LANGUAGE=1
RECOMMENDATION_WEIGHT_CONTEXT=1
RECOMMENDATION_WEIGHT_SOCIAL=1
RECOMMENDATION_WEIGHT_FRESHNESS=1
RECOMMENDATION_WEIGHT_QUALITY=0
RECOMMENDATION_WEIGHT_EXPLORATION=1
RECOMMENDATION_WEIGHT_NEGATIVE_PREFERENCE=1
RECOMMENDATION_WEIGHT_REPETITION=1
# Provisional starting values; calibrate against representative outcome data before release.
RECOMMENDATION_SIGNAL_WEIGHT_LIKE=0.18
RECOMMENDATION_SIGNAL_WEIGHT_UNLIKE=-0.12
RECOMMENDATION_SIGNAL_WEIGHT_SAVE=0.24
RECOMMENDATION_SIGNAL_WEIGHT_UNSAVE=-0.16
RECOMMENDATION_SIGNAL_WEIGHT_COMMENT=0
