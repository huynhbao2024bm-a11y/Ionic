APP_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://ionic_app:ionic_local_only@127.0.0.1:5433/ionic?sslmode=disable
WEB_ORIGINS=http://127.0.0.1:4200
ALLOW_SIGNUP=true
# Cloud preview: private object storage; never put a real key in this file.
# IONIC_ATTACHMENT_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-only-secret-key
# IONIC_STORAGE_BUCKET=ionic-media
RECOMMENDATION_NON_DISCRIMINATIVE_LABEL_PREVALENCE_THRESHOLD=0.95
# Per returned recommendation page; owner floor is 0.40, configurable upward.
RECOMMENDATION_MIN_RANDOM_SHARE=0.40
# Optional v8: apply migrations 0016/0017 before enabling collection.
RECOMMENDATION_ADAPTIVE_ENABLED=false
RECOMMENDATION_UNCERTAIN_RANDOM_SHARE=0.70
# Provisional issued-slot pacing / distinct-audience opportunities, not quality targets.
RECOMMENDATION_TOPIC_MIN_GAP=4
RECOMMENDATION_TOPIC_BASE_GAP=16
RECOMMENDATION_TOPIC_MAX_GAP=80
RECOMMENDATION_EVIDENCE_PRIOR=4
RECOMMENDATION_AUDIENCE_MIN=8
RECOMMENDATION_AUDIENCE_BASE=32
RECOMMENDATION_AUDIENCE_MAX=256
RECOMMENDATION_AUDIENCE_WINDOW_MINUTES=10
# Optional local semantics; prepare the pinned model and apply 0014/0015 first.
RECOMMENDATION_SEMANTIC_ENABLED=false
RECOMMENDATION_SEMANTIC_MIN_SIMILARITY=0.84
RECOMMENDATION_SEMANTIC_NEGATIVE_MARGIN=0.025
# Worker only: point to a real local Python 3.12+ executable.
# IONIC_PYTHON=C:/path/to/python.exe
# IONIC_MODEL_DIR=D:/Ionic/.models/e5-small
# IONIC_EMBED_THREADS=2
